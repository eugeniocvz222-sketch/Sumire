{
  "name": "sumire-apuntes",
  "productName": "Sumire Apuntes",
  "version": "1.0.0",
  "description": "Gestor de Apuntes Universitarios y Libretas Digitales",
  "author": "Eugenio Cavazos",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "app:dist": "node scripts/build-installer.js",
    "app:portable": "node scripts/build-installer.js --portable",
    "app:installer": "node scripts/build-installer.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.sumire.apuntes",
    "productName": "Sumire Apuntes",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/apuntes_mascot.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sumire Apuntes"
    }
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.30.6",
    "@tiptap/extension-task-item": "^3.30.6",
    "@tiptap/extension-task-list": "^3.30.6",
    "@tiptap/pm": "^3.30.6",
    "@tiptap/react": "^3.30.6",
    "@tiptap/starter-kit": "^3.30.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.38.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "sweetalert2": "^11.26.25",
    "sweetalert2-react-content": "^5.1.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  }
}
